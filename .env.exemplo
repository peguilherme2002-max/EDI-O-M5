# M5 — modelo do .env. Copie para .env e preencha. Chaves só no .env, nunca no Git, nunca no chat (F19).
# Guarde as chaves no seu gerenciador de senhas (6.6).

# narração (7.4) — modo API
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# fontes web (7.1)
PEXELS_API_KEY=
PIXABAY_API_KEY=
FREESOUND_API_KEY=
GIPHY_API_KEY=
# Openverse funciona sem chave; credenciais aumentam o limite
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Google Fonts: download sem chave; a chave só é usada para listar o catálogo pela API
GOOGLE_FONTS_API_KEY=
